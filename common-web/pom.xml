<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.trams</groupId>
        <artifactId>trams-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>common-web</artifactId>
    <name>TRAMS :: Common Web</name>
    <description>
        Cross-cutting HTTP concerns shared by both backing services: correlation-id
        propagation, gateway-only admission control, RS256 token verification and RFC 9457
        error rendering.

        Scoped to infrastructure that is identical in both services by definition. Each
        service still owns its own security rules, routes and domain error mapping - only
        the plumbing lives here.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.trams</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Nimbus JOSE, for JwtDecoder. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Two precise dependencies rather than spring-boot-starter-data-jpa: the shared
            error handler maps ObjectOptimisticLockingFailureException (spring-orm) and the
            paging envelope wraps Page (spring-data-commons). Pulling the whole JPA starter
            in here would impose Hibernate on every consumer of this module.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
    </dependencies>
</project>
