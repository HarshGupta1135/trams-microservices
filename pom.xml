<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot's starter parent is inherited for its curated dependency
        management and sensible plugin defaults. The version is pinned to the
        release that the Spring Cloud train below is built and tested against
        (see the note on spring-cloud.version).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.trams</groupId>
    <artifactId>trams-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>TRAMS</name>
    <description>
        Event-driven microservices system: an API Gateway fronting a User Service and a
        Notification Service that communicate asynchronously over NATS JetStream.
    </description>

    <modules>
        <module>common-contracts</module>
        <module>common-security</module>
        <module>common-messaging</module>
        <module>common-web</module>
        <module>user-service</module>
        <module>notification-service</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
            Spring Cloud 2025.1.3 is the latest GA release train and explicitly
            targets Spring Boot 4.0.8, which is why the parent above is pinned to
            4.0.8 rather than the newer 4.1.x line. Staying inside the supported
            compatibility matrix matters more for the gateway than being on the
            newest minor release.
        -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>

        <!--
            Versions NOT declared here (Flyway, Testcontainers, PostgreSQL driver,
            Jackson, JUnit, Awaitility, Logback, Micrometer) are inherited from the
            Spring Boot BOM on purpose: those are the exact versions this Boot
            release was tested against.
        -->
        <jnats.version>2.26.2</jnats.version>
        <springdoc.version>3.1.1</springdoc.version>
        <logstash-encoder.version>9.0</logstash-encoder.version>
        <bouncycastle.version>1.85.2</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Official NATS Java client, used for JetStream publish/consume. -->
            <dependency>
                <groupId>io.nats</groupId>
                <artifactId>jnats</artifactId>
                <version>${jnats.version}</version>
            </dependency>

            <!-- OpenAPI generation: servlet flavour for the services... -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- ...and the reactive flavour for the WebFlux-based gateway. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!--
                Resilience4j is not pinned here: the gateway consumes it through
                spring-cloud-starter-circuitbreaker-reactor-resilience4j, whose version
                the Spring Cloud train already manages (5.0.3).
            -->

            <!-- Structured JSON access/application logs. -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-encoder.version}</version>
            </dependency>

            <!-- Required by Spring Security's Argon2 password encoder. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Available to every module: assertions, JUnit 5, Mockito, Awaitility. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <compilerArgs>
                            <!-- Keep parameter names in the bytecode so Spring can
                                 bind constructor arguments without @ConstructorProperties. -->
                            <arg>-parameters</arg>
                            <arg>-Xlint:all,-serial,-processing</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Unit tests only; integration tests run under failsafe. -->
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Declared (not merely managed) so integration tests actually execute.
                A plugin left in pluginManagement contributes configuration but is never
                bound to the lifecycle, so `mvn verify` would silently run nothing.

                Unit tests run under Surefire on `mvn test`; *IT classes run here, under
                `mvn verify`, because they need a Docker daemon for Testcontainers.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
