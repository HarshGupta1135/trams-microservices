###############################################################################
# TRAMS - environment configuration template
#
# Copy to `.env` and fill in real values, or simply run:
#
#     bash scripts/generate-secrets.sh
#
# which writes a `.env` with a freshly generated RSA key pair and strong random
# passwords. `.env` is git-ignored; no secret in this system has a default value
# baked into an image or a source file.
###############################################################################

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker
# One of: TRACE DEBUG INFO WARN ERROR
LOG_LEVEL=INFO
# `json` for machine-readable logs (production), `console` for readable local output.
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Published ports on the host
#
# Only the gateway is published in docker-compose. The services, database,
# broker, cache and mail catcher stay on the internal network - the gateway is
# the single entry point by construction, not by convention.
# ---------------------------------------------------------------------------
GATEWAY_PORT=8080
# Mailpit's web UI, so you can watch notification emails arrive.
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# PostgreSQL
#
# The superuser credentials below are used only by the container's one-time
# initialisation script, which then creates one database per service, each owned
# by its own least-privilege role (see infra/postgres/init).
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser
POSTGRES_DB=postgres

USER_DB_NAME=users_db
USER_DB_USER=users_svc
USER_DB_PASSWORD=CHANGE_ME_users_db_password

NOTIFICATION_DB_NAME=notifications_db
NOTIFICATION_DB_USER=notifications_svc
NOTIFICATION_DB_PASSWORD=CHANGE_ME_notifications_db_password

# ---------------------------------------------------------------------------
# NATS
#
# Traffic is TLS-encrypted and each service authenticates with its own
# credentials, scoped by subject-level ACLs in infra/nats/nats-server.conf:
# the User Service may publish user events but not read them, and the
# Notification Service may read them but not forge them.
#
# Run `bash scripts/generate-tls.sh` before the first start to create the CA
# and server certificate.
# ---------------------------------------------------------------------------
NATS_URL=tls://nats:4222
NATS_TLS_CA_FILE=/etc/nats/tls/ca-cert.pem

NATS_USER_SERVICE_USER=user-service
NATS_USER_SERVICE_PASSWORD=CHANGE_ME_nats_user_service
NATS_NOTIFICATION_SERVICE_USER=notification-service
NATS_NOTIFICATION_SERVICE_PASSWORD=CHANGE_ME_nats_notification_service

# ---------------------------------------------------------------------------
# JWT signing (RS256)
#
# Asymmetric on purpose: only the User Service holds the private key, so the
# gateway and the Notification Service can *verify* a caller without holding
# the means to *impersonate* one. Both values are base64-encoded PEM, because a
# PEM's line breaks cannot be represented in a dotenv file.
#
# JWT_PRIVATE_KEY_BASE64 is supplied ONLY to the User Service.
# ---------------------------------------------------------------------------
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=https://trams.local
JWT_AUDIENCE=trams-api
JWT_KEY_ID=trams-signing-key-1
# Short-lived access token; long-lived, rotating refresh token.
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------------------
# Service-to-service authentication
#
# Proves a request arrived through the gateway. This is defence in depth, not
# the only control: the services are never published to the host. In a cluster
# this is the layer you would replace with mTLS / a service mesh identity.
# ---------------------------------------------------------------------------
INTERNAL_API_KEY=CHANGE_ME_internal_api_key_min_32_chars

# ---------------------------------------------------------------------------
# Redis - backs the gateway's distributed rate limiter
#
# Redis rather than an in-memory counter so the limit remains correct when the
# gateway runs more than one replica.
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# Steady-state requests/second per client, and the burst allowance.
RATE_LIMIT_REPLENISH_RATE=20
RATE_LIMIT_BURST_CAPACITY=40
# Authentication endpoints are limited far more aggressively: they are the
# targets for credential stuffing and password spraying.
AUTH_RATE_LIMIT_REPLENISH_RATE=3
AUTH_RATE_LIMIT_BURST_CAPACITY=8

# ---------------------------------------------------------------------------
# Outbound mail
#
# Locally this points at Mailpit, which captures every message and shows it in
# a web UI. In production these become a real relay's credentials.
# ---------------------------------------------------------------------------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS_ENABLED=false
MAIL_FROM=no-reply@trams.local
MAIL_FROM_NAME=TRAMS

# ---------------------------------------------------------------------------
# CORS - browser origins permitted to call the gateway
#
# An explicit allow-list. Never widen this to `*` on an API that accepts
# credentials.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Internal service addresses (used by the gateway's routes)
# ---------------------------------------------------------------------------
USER_SERVICE_URI=http://user-service:8081
NOTIFICATION_SERVICE_URI=http://notification-service:8082
